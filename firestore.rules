rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Real-time auth session exchange for desktop app
    match /auth_sessions/{sessionId} {
      allow read, write: if true;
    }

    // User profile, preferences, checklist, and library (supports web auth & desktop token sync)
    match /users/{userId} {
      allow read, write: if true;

      match /userData/{document=**} {
        allow read, write: if true;
      }

      match /ttmls/{document=**} {
        allow read, write: if true;
      }
    }

    // Public & Finished TTMLs Collection
    match /finished_ttmls/{ttmlId} {
      allow read, write: if true;
    }

    match /public_ttmls/{ttmlId} {
      allow read, write: if true;
    }

    // Collection group query support across all user ttmls
    match /{path=**}/ttmls/{document} {
      allow read: if true;
    }
  }
}
