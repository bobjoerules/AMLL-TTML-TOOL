rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Real-time auth session exchange for desktop app
    match /auth_sessions/{sessionId} {
      allow read, write: if true;
    }

    // User TTML Files & Library (allow public read for community library & website)
    match /users/{userId}/ttmls/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Public & Finished TTMLs Collection
    match /finished_ttmls/{ttmlId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /public_ttmls/{ttmlId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Collection group query support across all user ttmls
    match /{path=**}/ttmls/{document} {
      allow read: if true;
    }
  }
}
